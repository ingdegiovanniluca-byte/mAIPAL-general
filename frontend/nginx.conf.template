server {
    listen 80;
    # Upload di foto/documenti: il default di nginx (1 MB) rifiuta già una normale foto o
    # schermata da PC prima che arrivi al backend.
    client_max_body_size 25m;

    location = ${PUBLIC_URL} {
        return 301 ${PUBLIC_URL}/;
    }

    location ${PUBLIC_URL}/api/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # Alcune richieste incatenano più chiamate AI/Drive lente in sequenza
        # (OCR, embeddings, classificazione, upload su Drive): il default di
        # nginx (60s) le tronca con un 504 anche quando il backend sta ancora
        # lavorando correttamente.
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location ${PUBLIC_URL}/static/ {
        alias /usr/share/nginx/html${PUBLIC_URL}/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ${PUBLIC_URL}/ {
        alias /usr/share/nginx/html${PUBLIC_URL}/;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ ${PUBLIC_URL}/index.html;
    }
}
