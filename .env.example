# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# ---- Public URL where the app will be reachable (frontend origin + sub-path) ----
# Used both to build the React app (REACT_APP_BACKEND_URL) and by the backend to build
# absolute redirect URLs (Google OAuth, post-login redirects). Must match exactly what
# Cloudflare/nginx expose to the browser, including the /general sub-path.
APP_BASE_URL=https://maipal.it/general

# ---- MongoDB ----
MONGO_URL=mongodb://mongodb:27017
DB_NAME=maipal

# ---- LLM providers (replace the old Emergent-platform key) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Admin ----
ADMIN_EMAIL=ingdegiovanniluca@gmail.com

# ---- CORS: comma-separated list of allowed origins ----
CORS_ORIGINS=https://maipal.it

# ---- Google OAuth (login + Drive/Calendar integration) ----
# Create at https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application").
# Authorized redirect URIs to register:
#   https://maipal.it/general/api/auth/google/callback         (login)
#   https://maipal.it/general/api/integrations/google/callback (Drive/Calendar)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Telegram bot (optional) ----
TELEGRAM_BOT_TOKEN=
